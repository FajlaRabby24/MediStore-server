<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Google Login</title>
  </head>
  <body
    data-better-auth-url="<%= betterAuthUrl %>"
    data-callback-url="<%= callbackURL %>"
  >
    <div>
      <p>Redirecting to Google...</p>
    </div>
    <script>
      (async () => {
        try {
          const betterAuthUrl = "<%= betterAuthUrl %>";
          const callbackURL = "<%= callbackURL %>";

          console.log("Redirecting to Google via Better Auth...");

          const response = await fetch(`${betterAuthUrl}/api/auth/sign-in/social`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            credentials: "include",
            body: JSON.stringify({
              provider: "google",
              callbackURL: callbackURL,
            }),
          });

          const data = await response.json();

          if (data.url) {
            window.location.href = data.url;
          } else {
            console.error("Auth redirect URL not found in response:", data);
            document.body.innerHTML = `<div>
                          <p style="color: red; font-family: sans-serif; text-align: center; margin-top: 50px;">
                              Error Occurred While Redirecting To Google. Please Try Again Later.
                          </p>
                          </div>`;
          }
        } catch (error) {
          console.error("Social login redirect error:", error);
          document.body.innerHTML = `<div>
                          <p style="color: red; font-family: sans-serif; text-align: center; margin-top: 50px;">
                              Error Occurred While Redirecting To Google. Please Try Again Later.<br>
                              <small>${error.message}</small>
                          </p>
                          </div>`;
        }
      })();
    </script>
  </body>
</html>
